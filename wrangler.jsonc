{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-your-engineer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The worker runs only for the page itself (to name its card in the tags) and for the card.
    // Everything else is served straight from the assets.
    "run_worker_first": ["/", "/og.png"]
  },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }]
}
