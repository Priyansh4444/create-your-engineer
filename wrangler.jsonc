{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-your-engineer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The worker only runs for the share routes. Everything else is served straight from the assets.
    "run_worker_first": ["/api/*", "/s/*", "/i/*"]
  },
  "kv_namespaces": [{ "binding": "SHARES", "id": "3f861de4e708471c9d7d03f5fb00b132" }]
}
